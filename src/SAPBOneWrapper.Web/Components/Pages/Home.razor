@page "/"
@using Microsoft.AspNetCore.Authorization

<PageTitle>SAP B1 Wrapper</PageTitle>

<div class="text-center py-5">
    <h1>SAP Business One Wrapper</h1>
    <p class="lead mt-3">Manage Business Partners with local caching and SAP B1 Service Layer synchronization.</p>

    <AuthorizeView>
        <Authorized>
            <a href="business-partners" class="btn btn-primary btn-lg mt-3">Go to Business Partners</a>
        </Authorized>
        <NotAuthorized>
            <a href="login" class="btn btn-primary btn-lg mt-3 me-2">Login</a>
            <a href="register" class="btn btn-outline-primary btn-lg mt-3">Register</a>
        </NotAuthorized>
    </AuthorizeView>
</div>
